{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "lib - Vitest debug current file",
      "program": "${workspaceFolder}/packages/lib/node_modules/vite-plus/bin/vp",
      "args": ["test", "run", "${file}"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["**/node_modules/**", "<node_internals>/**"],
      "cwd": "${workspaceFolder}/packages/lib"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "mobx-keystone-yjs - Vitest debug current file",
      "program": "${workspaceFolder}/packages/mobx-keystone-yjs/node_modules/vite-plus/bin/vp",
      "args": ["test", "run", "${file}"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["**/node_modules/**", "<node_internals>/**"],
      "cwd": "${workspaceFolder}/packages/mobx-keystone-yjs"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "mobx-keystone-loro - Vitest debug current file",
      "program": "${workspaceFolder}/packages/mobx-keystone-loro/node_modules/vite-plus/bin/vp",
      "args": ["test", "run", "${file}"],
      "autoAttachChildProcesses": true,
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "skipFiles": ["**/node_modules/**", "<node_internals>/**"],
