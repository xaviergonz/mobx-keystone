  "scripts": {
    "lib:build": "vp run mobx-keystone#build",
    "lib:build-docs": "vp run mobx-keystone#build-docs",
    "benchmark:build": "vp run benchmark#build",
    "lib:test": "vp run mobx-keystone#test",
    "lib:test:ci": "vp run mobx-keystone#test:ci",
    "yjs-lib:build": "vp run mobx-keystone-yjs#build",
    "yjs-lib:test": "vp run mobx-keystone-yjs#test",
    "yjs-lib:test:ci": "vp run mobx-keystone-yjs#test:ci",
    "loro-lib:build": "vp run mobx-keystone-loro#build",
    "loro-lib:test": "vp run mobx-keystone-loro#test",
    "loro-lib:test:ci": "vp run mobx-keystone-loro#test:ci",
    "site:start": "vp run site#start",
